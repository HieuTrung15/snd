 "html": "<style>\r\n.print-format {\r\n    font-family: \"Times New Roman\", serif;\r\n    font-size: 16px;\r\n    line-height: 1.6;\r\n    margin: 0 auto;\r\n    width: 210mm;\r\n    min-height: 297mm;\r\n    padding: 4mm 4mm 3mm 5mm;\r\n}\r\n.print-format table {\r\n    border: none;\r\n    width: 100%;\r\n}\r\n.print-format td {\r\n    border: none;\r\n    padding: 2px;\r\n}\r\nh2 {\r\n    text-align: center;\r\n    font-weight: bold;\r\n    text-transform: uppercase;\r\n}\r\nh3{\r\n    text-align: center;\r\n    font-weight: bold;\r\n}\r\np {\r\n    text-align: justify;\r\n    margin: 6px 0;\r\n}\r\n.signature {\r\n    margin-left: 10px;\r\n    margin-top: 40px;\r\n    display: flex;\r\n    justify-content: space-between;\r\n}\r\n.signature div {\r\n    width: 30%;\r\n    text-align: center;\r\n}\r\n</style>\r\n\r\n{%- set doc = frappe.get_doc('VNT Business Trip Request', doc.name) -%}\r\n{%- set signature_name = 'Phi\u1ebfu \u0111\u1ec1 ngh\u1ecb thanh to\u00e1n' + '-' + doc.company -%}\r\n{%- set dntt_letter_head = frappe.get_all('Letter Head', filters={'name': 'Default Letter Head T\u1eadp \u0111o\u00e0n'}, pluck=\"content\") -%}\r\n\r\n<div class=\"print-format\">\r\n<table style=\"width:100%; margin-bottom:20px; border:none;\">\r\n  <tr>\r\n    <td style=\"width:45%; text-align:center; border:none; vertical-align:middle;\">\r\n      {{ dntt_letter_head[0] | safe }}\r\n    </td>\r\n    <td style=\"width:55%; text-align:center; border:none; vertical-align:middle;\">\r\n        <div style=\"margin-top:10px\">\r\n          <b>C\u1ed8NG H\u00d2A X\u00c3 H\u1ed8I CH\u1ee6 NGH\u0128A VI\u1ec6T NAM</b><br/>\r\n          <i>\u0110\u1ed9c l\u1eadp - T\u1ef1 do - H\u1ea1nh ph\u00fac</i>\r\n        </div>\r\n    </td>\r\n  </tr>\r\n</table>\r\n\r\n\r\n\r\n\r\n    <h2>T\u1edc TR\u00ccNH \u0110I C\u00d4NG T\u00c1C</h2>\r\n\r\n    <h3>K\u00ednh g\u1eedi:L\u00e3nh \u0111\u1ea1o T\u1eadp \u0111o\u00e0n</h3>\r\n\r\n    <p>C\u0103n c\u1ee9 ch\u1ee9c n\u0103ng nhi\u1ec7m v\u1ee5 c\u1ee7a {{ doc.department or \"\" }};</p>\r\n\r\n    <p>{{ doc.department or \"\" }} k\u00ednh \u0111\u1ec1 ngh\u1ecb L\u00e3nh \u0111\u1ea1o T\u1eadp \u0111o\u00e0n ph\u00ea duy\u1ec7t k\u1ebf ho\u1ea1ch c\u00f4ng t\u00e1c c\u1ee7a Ban nh\u01b0 sau:</p>\r\n\r\n    <p><b>1.N\u1ed9i dung c\u00f4ng t\u00e1c:</b></p>\r\n    <p>{{ doc.purpose or \"\" }}</p>\r\n\r\n    <p><b>2.Th\u1eddi gian c\u00f4ng t\u00e1c:</b> \u0110i ng\u00e0y {{ frappe.utils.formatdate(doc.from_date) }}\r\n        v\u00e0 d\u1ef1 ki\u1ebfn v\u1ec1 ng\u00e0y {{ frappe.utils.formatdate(doc.to_date) }}</p>\r\n\r\n    <p><b>-Th\u00e0nh ph\u1ea7n g\u1ed3m:</b></p>\r\n    <ul style=\"list-style-type:none; padding-left:10; margin:0;\">\r\n    {%- for row in doc.items -%}\r\n        <li>{{ row.salutation }} {{ row.employee_name }}</li>\r\n    {%- endfor -%}\r\n    </ul>\r\n\r\n    <p><b>Ph\u01b0\u01a1ng ti\u1ec7n di chuy\u1ec3n:</b></p>\r\n    <ul style=\"list-style-type:none; padding-left:10; margin:0;\">\r\n    {%- for t in doc.transportation -%}\r\n        <li>{{ t.transport_mode }}: {{ t.travel_route }}</li>\r\n    {%- endfor -%}\r\n    </ul>\r\n    \r\n\r\n    <p><b>Chi ph\u00ed c\u00f4ng t\u00e1c:</b> Theo quy \u0111\u1ecbnh c\u1ee7a T\u1eadp \u0111o\u00e0n</p>\r\n\r\n    <p>K\u00ednh tr\u00ecnh L\u00e3nh \u0111\u1ea1o T\u1eadp \u0111o\u00e0n xem x\u00e9t ph\u00ea duy\u1ec7t./.</p>\r\n\r\n    <div class=\"signature\">\r\n        <div>\r\n            <b>L\u00e3nh \u0111\u1ea1o T\u1eadp \u0111o\u00e0n</b><br/>\r\n            <i>Ph\u00f3 T\u1ed5ng Gi\u00e1m \u0110\u1ed1c</i>\r\n        </div>\r\n        <div>\r\n            <b>{{ doc.department or \"\" }}</b><br/>\r\n            <i>Tr\u01b0\u1edfng Ban</i>\r\n        </div>\r\n    </div>\r\n</div>\r\n",
